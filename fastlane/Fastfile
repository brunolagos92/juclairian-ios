# Signer et envoyer dans TestFlight — appelé par .github/workflows/construire.yml.
#
# ⚠️ POURQUOI FASTLANE ET LA SIGNATURE MANUELLE. La signature automatique de Xcode a échoué six fois
# sur la machine de GitHub, qui repart de zéro à chaque construction : il lui faut un profil de
# DÉVELOPPEMENT (donc un appareil enregistré), il en recrée de nouveaux à chaque passage, et l'app et
# son extension se disputent leur création — le relevé de l'essai 6 montrait UN profil présent pour
# deux réclamés. Ici, `match` crée UNE FOIS le certificat de distribution et les deux profils App
# Store, les garde chiffrés dans la branche `signature` de ce dépôt, et chaque construction les
# reprend tels quels. Ni appareil, ni profil de développement, ni course entre les cibles.
#
# Les profils portent les noms que project.yml attend en Release : « match AppStore <identifiant> ».

require "base64"

default_platform(:ios)

# Chaque app : son schéma, son identifiant, celui de son extension s'il y en a une. Une app de plus = une ligne
# ici, ses cibles dans project.yml, et sa fiche App Store Connect créée à la main (CLAUDE.md).
APPS = {
  "Orla" => ["com.juclairian.orla", "com.juclairian.orla.partage"],
  "Vela" => ["com.juclairian.vela", "com.juclairian.vela.partage"],
  "Hora" => ["com.juclairian.hora"],
  "Numeria" => ["com.juclairian.numeria"],
  "Electra" => ["com.juclairian.electra"],
}
IDS = APPS.values.flatten

platform :ios do
  lane :testflight do
    setup_ci # un trousseau temporaire, propre à cette construction

    cle = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      in_house: false
    )

    # ⚠️ Les identifiants de l'app et de son extension doivent EXISTER chez Apple avant leurs profils.
    # La signature automatique se contentait du joker « XC Wildcard » : l'essai 7 a trouvé le compte
    # sans aucun identifiant (« Couldn't find bundle identifier »). On les déclare s'ils manquent.
    IDS.each do |id|
      next if Spaceship::ConnectAPI::BundleId.find(id)
      nom = id.split(".").drop(2).map(&:capitalize).join(" ") # « Orla », « Orla Partage »
      UI.message("Déclaration de l'identifiant #{id} (#{nom})")
      Spaceship::ConnectAPI::BundleId.create(name: nom, platform: "IOS", identifier: id)
    end

    match(
      type: "appstore",
      app_identifier: IDS,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      api_key: cle,
      storage_mode: "git",
      git_url: "https://github.com/brunolagos92/juclairian-ios.git",
      git_branch: "signature",
      git_basic_authorization: Base64.strict_encode64("x-access-token:#{ENV.fetch('GITHUB_TOKEN')}"),
      # La machine de GitHub n'a pas d'identité git : sans elle, le premier dépôt des profils échoue.
      git_full_name: "github-actions[bot]",
      git_user_email: "41898282+github-actions[bot]@users.noreply.github.com",
      # setup_ci met match en lecture seule ; ici il doit pouvoir créer ce qui manque la première
      # fois. Ensuite il reprend l'existant.
      readonly: false
    )

    # ⚠️ CHAQUE APP POUR ELLE-MÊME : une fiche App Store Connect qui manque (une app neuve) n'empêche pas les
    # autres de partir. On construit tout, on envoie ce qui a sa fiche, et l'on DIT à la fin ce qui attend.
    sans_fiche = []
    APPS.each do |schema, ids|
      build_app(
        project: "Juclairian.xcodeproj",
        scheme: schema,
        configuration: "Release",
        export_method: "app-store",
        xcargs: "CURRENT_PROJECT_VERSION=#{ENV.fetch('GITHUB_RUN_NUMBER')}",
        output_directory: ENV.fetch("RUNNER_TEMP"),
        output_name: schema,
        export_options: {
          provisioningProfiles: ids.to_h { |id| [id, "match AppStore #{id}"] }
        }
      )
      # L'API d'Apple ne sait pas créer la fiche de l'app dans App Store Connect : c'est à la main, une
      # fois. On le dit en clair plutôt que de laisser l'envoi échouer sur un message obscur.
      unless Spaceship::ConnectAPI::App.find(ids.first)
        sans_fiche << "#{schema} (#{ids.first})"
        next
      end
      upload_to_testflight(api_key: cle, ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
                           skip_waiting_for_build_processing: true)
    end
    unless sans_fiche.empty?
      UI.user_error!("Construit et signé, mais pas envoyé : #{sans_fiche.join(', ')} n'existe pas encore " \
                     "dans App Store Connect (Apps → + → Nouvelle app).")
    end
  end
end
